# ===================================================================
# Environment Configuration Template
# ===================================================================
# このファイルはテンプレートです。コミット可能です。
# 実際の値はローカル開発では .env.local、CI環境ではGitHub Secretsから注入されます。

# ===================================================================
# Application Environment
# ===================================================================
# local: ローカル開発用
# test: テスト環境用  
# production: 本番環境用
NODE_ENV=local

# InMemory DB を使用するかどうか（ローカルテスト用）
USE_IN_MEMORY_DB=false

# ===================================================================
# Cloudflare Configuration
# ===================================================================
# CI環境: ワークフローがCLOUDFLARE_WORKERS_API_TOKEN/CLOUDFLARE_PAGES_API_TOKEN/
#   CLOUDFLARE_D1_API_TOKEN/CLOUDFLARE_ANALYTICS_API_TOKEN（用途ごとに権限を絞った
#   別々のGitHub Secrets、詳細はpackages/README.md「環境変数管理」）を自動注入する。
# ローカル: wrangler CLIは環境変数名を`CLOUDFLARE_API_TOKEN`に固定して読むため、
#   これから行う操作（Workers deploy / D1操作 / Pages deploy）に対応する
#   スコープのトークン値をこの変数へ設定して使う。
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here

# ===================================================================
# Database Configuration (D1)
# ===================================================================
# Terraform が自動生成し、GitHub Secrets に保存される値
# wrangler.toml で ${DB_ID} として参照される
# CI環境: ワークフローで自動注入
# ローカル: preview で上書きされる
DB_ID=your_database_id_here

# ===================================================================
# Scraping Service Configuration
# ===================================================================
# スクレイピング結果をバッチ処理で取得するためのURL
# テスト環境: GitHub Secrets の SCRAPING_API_URL_TEST から注入
# 本番環境: GitHub Secrets の SCRAPING_API_URL から注入
SCRAPING_API_URL=http://localhost:8786

# ===================================================================
# Main API Configuration
# ===================================================================
# バッチ処理がメインAPIに結果を送信するためのURL
MAIN_API_URL=http://localhost:8001

# ===================================================================
# CORS Configuration
# ===================================================================
# APIのCORS許可オリジン（カンマ区切り）
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ===================================================================
# HTML Fetching Configuration
# ===================================================================
# HTMLフェッチの遅延時間（ミリ秒）
# スクレイピングサーバーへの負荷軽減のため調整可能
HTML_FETCH_DELAY_MS=300

# ===================================================================
# ===================================================================
# Google Calendar Integration
# ===================================================================
# Google Calendar API のサービスアカウント設定
# 認証情報: Google Cloud Console で作成したサービスアカウントのキーファイルから取得

# サービスアカウントのメールアドレス
GOOGLE_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com

# サービスアカウントの秘密鍵（PEM形式）
# "-----BEGIN PRIVATE KEY-----" から "-----END PRIVATE KEY-----" まで
# 改行は \n に置き換える
GOOGLE_PRIVATE_KEY=-----BEGIN PRIVATE_KEY-----\nYour_Base64_Encoded_Key_Here\n-----END PRIVATE KEY-----

# ===================================================================
# Race Type Calendar IDs
# ===================================================================
# 各競馬場のGoogle Calendar ID
# 日程情報の自動登録に使用

# JRA（日本中央競馬会）カレンダーID
JRA_CALENDAR_ID=your_jra_calendar_id@group.calendar.google.com

# NAR（地方競馬全国協会）カレンダーID
NAR_CALENDAR_ID=your_nar_calendar_id@group.calendar.google.com

# 海外レースカレンダーID（RaceType.OVERSEAS に対応）
OVERSEAS_CALENDAR_ID=your_overseas_calendar_id@group.calendar.google.com
# 後方互換: 旧キー WORLD_CALENDAR_ID も引き続き読み取り可能（OVERSEAS_CALENDAR_ID 未設定時のフォールバック）。
# 既存環境の移行時は上記 OVERSEAS_CALENDAR_ID への置き換えを推奨。
# WORLD_CALENDAR_ID=your_world_calendar_id@group.calendar.google.com

# 競輪カレンダーID
KEIRIN_CALENDAR_ID=your_keirin_calendar_id@group.calendar.google.com

# オートレースカレンダーID
AUTORACE_CALENDAR_ID=your_autorace_calendar_id@group.calendar.google.com

# ボートレースカレンダーID
BOATRACE_CALENDAR_ID=your_boatrace_calendar_id@group.calendar.google.com

# ===================================================================
# Service-to-Service Authentication
# ===================================================================
# Worker間・CIからの書き込み系呼び出しに必須の共有シークレット
# 生成例: openssl rand -base64 32
SERVICE_AUTH_TOKEN=replace_me_with_a_random_32_byte_base64_value

# ローテーション期間中のみ設定する旧シークレット（service-auth-design.md §8.1）
# SERVICE_AUTH_TOKEN_PREVIOUS=replace_me_with_the_previous_token_during_rotation


{
    "editor.defaultFormatter": "biomejs.biome",
    "editor.formatOnSave": true,
    "editor.formatOnPaste": true,
    "editor.codeActionsOnSave": {
        // For Biome（フォーマット・import整理・標準lintルール）
        "source.fixAll.biome": "always",
        "source.organizeImports.biome": "always",
        // For ESLint（Biomeでは代替できない独自ルール・jsdocのみ）
        "source.fixAll.eslint": "always",
        // For TSLint
        "source.fixAll.tslint": "always",
        // For Stylelint
        "source.fixAll.stylelint": "always"
    },
    "[yaml]": {},
    "yaml.schemas": {
        "https://json.schemastore.org/github-workflow.json": ".github/workflows/*.yml",
        "https://json.schemastore.org/github-action.json": ".github/actions/**/action.yml"
    },
    "yaml.validate": true,
    "yaml.lint.enabled": true,
    "spellright.language": ["en", "ja"],
    "spellright.documentTypes": ["markdown", "latex", "plaintext"],
    // cSpell: 16進カラーコードなどのプロジェクト固有の単語
    "cSpell.words": ["fbca", "tfvars"],
    "chat.tools.terminal.autoApprove": {
        "wrangler": true,
        "bun": true,
        "tsc": true,
        "./node_modules/.bin/eslint": true,
        "bunx": true,
        "timeout": true,
        "mkdir": true,
        "pkill": true,
        "lsof": true,
        "envsubst": true
    },
    // Exclude heavy/build folders from file indexing/search/watcher to avoid
    // overwhelming IntelliSense and the TypeScript server in large monorepos.
    "files.exclude": {
        "**/node_modules": true,
        "**/dist": true,
        "**/build": true,
        "**/.wrangler/tmp": true,
        "coverage": true,
        "tmp": true,
        "**/.cache": true,
        ".git": true
    },
    "search.exclude": {
        "**/node_modules": true,
        "**/dist": true,
        "**/build": true,
        "**/.wrangler/tmp": true,
        "coverage": true,
        "tmp": true
    },
    "files.watcherExclude": {
        "**/node_modules/**": true,
        "**/dist/**": true,
        "**/build/**": true,
        "**/.wrangler/tmp/**": true,
        "coverage/**": true,
        "tmp/**": true
    },

    // Use workspace TypeScript version (required for TypeScript 6.0+)
    "js/ts.tsdk.path": "node_modules/typescript/lib",
    "js/ts.tsdk.promptToUseWorkspaceVersion": true,

    "[js/ts]": {
        // Increase TS server memory to help with large monorepos
        "typescript.tsserver.maxMemory": 4096,

        // Ensure the workspace uses the project's tsconfig for IntelliSense
        "js/ts.preferences.importModuleSpecifier": "relative",

        // Enable incremental compilation for faster IntelliSense
        "typescript.tsserver.experimental.enableProjectDiagnostics": false,

        // Use project references for better performance in monorepo
        "typescript.tsdk.promptToUseWorkspaceVersion": true,
        "typescript.tsserver.automaticTypeAcquisition.enabled": false,

        // Limit IntelliSense to improve performance
        "typescript.suggest.autoImports": true,
        "typescript.updateImportsOnFileMove.enabled": "always",

        // Faster file watching by polling
        "typescript.tsserver.watchOptions": {
            "watchFile": "useFsEvents",
            "watchDirectory": "useFsEvents",
            "excludeDirectories": [
                "**/node_modules",
                "**/dist",
                "**/build",
                "coverage",
                "tmp"
            ]
        }
    },

    // Disable preview mode to prevent tab accumulation
    "workbench.editor.enablePreview": false,
    "workbench.editor.enablePreviewFromQuickOpen": false,

    // Disable GitKraken extension - use standard git commands instead
    "extensions.ignoreRecommendations": true,
    "[git]": {
        "mergeEditor": true
    },

    // GitKrakenを完全に無効化し、標準gitコマンドを使用
    "extensions.recommendations": [],
    "scm.showIncomingChanges": "never",
    "scm.showOutgoingChanges": "never",
    "[GitKraken]": {
        "extensions.ignoreRecommendations": true
    },

    // Prefer terminal git commands over VS Code GUI
    "git.enabled": true,
    "git.ignoreLimitWarning": true,
    "git.showOutput": "always",
    "git.closeRepositoryAfterPull": false
}

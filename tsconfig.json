{
    "extends": "./tsconfig.base.json",
    "include": [
        "packages/*/src/**/*.ts",
        "packages/*/test/**/*.ts",
        "packages/*/script/**/*.ts",
        "packages/*/scripts/**/*.ts",
        "tests/**/*.ts",
        "scripts/**/*.ts",
        "eslint-rules/**/*.ts"
    ],
    "exclude": ["node_modules", "**/node_modules", "coverage", "tmp"]
}

{
    "name": "@race-schedule/calendar",
    "version": "0.1.0",
    "private": true,
    "description": "Calendar sync service - Cloudflare Worker that syncs race schedules from the main API to Google Calendar",
    "main": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts",
        "./src/*": "./src/*.ts"
    },
    "scripts": {
        "test": "bun test",
        "test:watch": "bun test --watch",
        "type-check": "tsc --noEmit",
        "build": "tsc --noEmit",
        "dev": "wrangler dev",
        "deploy:development": "bunx wrangler deploy --env development",
        "deploy:test": "bunx wrangler deploy --env test",
        "deploy:production": "bunx wrangler deploy --env production",
        "lint": "eslint './src/**/*.ts'",
        "lint:fix": "eslint --fix './src/**/*.ts'"
    },
    "dependencies": {
        "@race-schedule/core": "workspace:*",
        "googleapis": "^174.0.0",
        "hono": "^4.12.32",
        "reflect-metadata": "^0.2.2",
        "tsyringe": "^4.10.0",
        "zod": "^4.4.3"
    }
}

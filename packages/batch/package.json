{
    "name": "@race-schedule/batch",
    "version": "0.1.0",
    "private": true,
    "description": "Batch processing service - Cloudflare Worker that triggers scraping and data ingestion via HTTP API",
    "main": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts",
        "./src/*": "./src/*.ts"
    },
    "scripts": {
        "test": "bun test",
        "test:watch": "bun test --watch",
        "type-check": "tsc --noEmit",
        "build": "tsc --noEmit",
        "dev": "wrangler dev",
        "deploy:development": "bunx wrangler deploy --env development",
        "deploy:test": "bunx wrangler deploy --env test",
        "deploy:production": "bunx wrangler deploy --env production",
        "lint": "eslint './src/**/*.ts'",
        "lint:fix": "eslint --fix './src/**/*.ts'",
        "batch": "bun src/cli.ts"
    },
    "dependencies": {
        "@race-schedule/core": "workspace:*",
        "date-fns": "^4.4.0",
        "hono": "^4.12.32",
        "zod": "^4.4.3"
    }
}

{
    "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",

    "mutate": [
        "packages/admin/src/**/*.ts",
        "!packages/admin/src/**/index.ts",
        "!packages/admin/src/**/constants/**",
        "!packages/admin/src/**/types/**",
        "!packages/admin/src/di/**"
    ],

    "testRunner": "command",
    "commandRunner": {
        "command": "NODE_ENV=ci_local TZ=jst HTML_FETCH_DELAY_MS=0 bun test packages/admin/test/unittest"
    },
    "coverageAnalysis": "off",

    "reporters": ["html", "clear-text", "progress-append-only"],
    "htmlReporter": {
        "fileName": "reports/mutation/admin/index.html"
    },

    "thresholds": {
        "high": 80,
        "low": 60,
        "break": null
    },

    "timeoutMS": 30000,

    "ignorePatterns": [
        "private",
        ".claude",
        ".aidlc-rule-details",
        "CLAUDE.md",
        "AGENTS.md",
        "aidlc-docs",
        "docs"
    ]
}
